# Google Cloud / Vertex AI (Gemini)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FAST_MODEL=gemini-3.7-flash
# Who does the agent's work. replay: fixture mode replays the real Gemini runs recorded in
# fixtures/agent/ (no Gemini calls). gemini: the ADK agent runs live on Vertex AI (with
# SIFT_MODE=fixture it works on the fixture data). Needs the three variables above + ADC.
SIFT_AGENT=replay
# Spend caps for one agent run (Run analysis or one Ask Sift answer)
SIFT_GEMINI_MAX_TOKENS_PER_RUN=600000
SIFT_GEMINI_MAX_LLM_CALLS=40
# Optional: otelcol-contrib binary for `otelcol validate` of drafted rules and of the managed
# Collector config before Sift writes it. Empty = checked in code only ("not run").
SIFT_OTELCOL_BIN=

# Dynatrace Environment & Platform URLs
DT_ENV_URL=https://abc12345.live.dynatrace.com
DT_PLATFORM_URL=https://abc12345.apps.dynatrace.com
# Platform token for Sift (read): storage:logs:read storage:spans:read storage:metrics:read
# storage:events:read storage:system:read storage:buckets:read document:documents:read
# automation:workflows:read slo:slos:read settings:objects:read; for the MCP server also
# mcp-gateway:servers:invoke mcp-gateway:servers:read. (Settings scope for custom alerts:
# TODO(verify).) noisegen setup also needs document:documents:write.
DT_PLATFORM_TOKEN=
# Ingest token for the OTel Collector, sent as "Authorization: Bearer": platform token with
# openpipeline:traces:ingest openpipeline:metrics:ingest openpipeline:logs:ingest
DT_API_TOKEN=
# Remote MCP server. Discovery (tools/list): empty = <DT_PLATFORM_URL>/platform-reserved/mcp-gateway/v0.1/servers/dynatrace-mcp/mcp
# The agent adds the Dynatrace MCP toolset only when this is set (Bearer DT_PLATFORM_TOKEN).
DT_MCP_URL=

# Sift Configuration
SIFT_MODE=fixture
# Where an approved rule goes: dry-run (never writes) | otelcol | openpipeline
SIFT_APPLY_TARGET=dry-run
SIFT_DB=./data/sift.db
# Minutes between apply and verification (2 for a live demo)
SIFT_VERIFY_WINDOW_MIN=30
# otelcol target: the Collector config Sift manages (copied from the base on first apply) and
# how the Collector is told to reload it: none | pid:<pid or pid file> | docker:<container>
SIFT_OTELCOL_CONFIG=./data/otelcol/config.yaml
SIFT_OTELCOL_BASE=./infra/otel-collector/dynatrace.yaml
SIFT_OTELCOL_RELOAD=none
# openpipeline target: customId of the pipeline the data is routed to (Settings 2.0 object of
# builtin:openpipeline.<logs|spans|metrics>.pipelines). Needs DT_ENV_URL and a platform token
# with settings:objects:read and settings:objects:write (TODO(verify) on a tenant).
SIFT_OPENPIPELINE_PIPELINE=
# Fixture mode only: verification finishes after this many seconds instead of the window
SIFT_FIXTURE_VERIFY_SECONDS=8
# Fixture mode only: pacing of scripted runs and chat (1 = recorded pace, 0 = instant)
SIFT_REPLAY_SPEED=1
SIFT_FIXTURES=./fixtures

# noisegen (share of the demo world's volume; 0.002 = about 80 KB/min)
NOISEGEN_SCALE=0.002
NOISEGEN_SEED=42
NOISEGEN_SECONDS=900

# Sift MCP server (mcp/): where the Sift API runs, and the base of links in its answers
SIFT_API_URL=http://localhost:8000
SIFT_UI_URL=
